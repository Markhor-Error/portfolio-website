---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  heading?: string;
  intro?: string;
  eyebrow?: string;
  trail: { name: string; href: string }[];
  noindex?: boolean;
  schema?: unknown[];
}
const { title, description, heading, intro, eyebrow, trail, noindex, schema } = Astro.props;
---
<Base title={title} description={description} trail={trail} noindex={noindex} schema={schema}>
  <div class="wrap-c page">
    <Breadcrumbs trail={trail} />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{heading ?? title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <div class="body"><slot /></div>
  </div>
</Base>
<style>
  .page { padding-block: var(--s-6) var(--s-8); }
  h1 { max-width: 24ch; }
  .intro { font-size: var(--fs-lg); color: var(--text-muted); max-width: 62ch;
    margin-bottom: var(--s-7); }
  .body { max-width: var(--w-prose); }
  .body :global(h2) { margin-top: var(--s-7); font-size: var(--fs-xl); }
  .body :global(h3) { margin-top: var(--s-5); font-size: var(--fs-lg); }
  .body :global(li) { margin-bottom: var(--s-2); }
  .body :global(li::marker) { color: var(--brand); }
  .body :global(.table-scroll) { max-width: var(--w-content); }
</style>
