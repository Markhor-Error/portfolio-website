---
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">Common questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
<style>
  .faq { margin-top: var(--s-8); }
  .faq p { font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.7; margin: 0; }
</style>
