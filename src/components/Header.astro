---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="15" fill="var(--brand)"></circle>
        <path d="M9.5 20.5 16 8l6.5 12.5-6.5-3.6z" fill="var(--brand-ink)" opacity=".95"></path>
        <path d="M16 16.9v6.4" stroke="var(--brand-ink)" stroke-width="1.6" stroke-linecap="round" opacity=".7"></path>
      </svg>
      <span class="brand-text">Going&nbsp;<em>Eagle</em></span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list">
        {NAV.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class="nav-link"
              aria-current={isActive(item.href) ? 'true' : undefined}
            >{item.label}</a>
            <div class="panel">
              <ul class="panel-list">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button" class="icon-btn" id="theme-toggle"
        aria-label="Switch colour theme" title="Switch colour theme"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.6v2M12 19.4v2M2.6 12h2M19.4 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
        </svg>
      </button>
      <button
        type="button" class="icon-btn nav-toggle" id="nav-toggle"
        aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="wrap">
      {NAV.map((item) => (
        <details class="m-group">
          <summary>{item.label}</summary>
          <ul>
            {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ul>
        </details>
      ))}
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex; align-items: center; gap: var(--s-5);
    min-height: var(--header-h);
  }

  .brand { display: inline-flex; align-items: center; gap: var(--s-3);
    text-decoration: none; color: var(--text); flex-shrink: 0; }
  .brand-mark { width: 30px; height: 30px; }
  .brand-text { font-family: var(--font-display); font-weight: 600;
    font-size: 1.22rem; letter-spacing: -.02em; white-space: nowrap; }
  .brand-text em { font-style: normal; color: var(--brand); }

  .nav { margin-inline-start: auto; }
  .nav-list { display: flex; gap: var(--s-1); list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-link {
    display: inline-block; padding: var(--s-3) var(--s-4);
    font-size: var(--fs-sm); font-weight: 600; color: var(--text);
    text-decoration: none; border-radius: var(--r-md);
  }
  .nav-link:hover, .nav-item:hover .nav-link { background: var(--surface-2); color: var(--brand); }
  .nav-link[aria-current] { color: var(--brand); }

  /* Mega panel. Opens on hover and on keyboard focus within the item. */
  .panel {
    position: absolute; top: calc(100% + 2px); left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 21rem;
    /* Never wider than the viewport allows, whatever min-width asks for. */
    max-width: calc(100vw - 2 * var(--gutter));
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--s-4);
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity .14s ease, transform .14s ease, visibility .14s;
  }
  .nav-item:hover .panel, .nav-item:focus-within .panel {
    opacity: 1; visibility: visible; pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  /* The last trigger sits close enough to the right edge that a centred panel
     hangs off the viewport and scrolls the whole page sideways. Anchor that one
     to its own right edge instead. */
  .nav-item:last-child .panel {
    left: auto; right: 0; transform: translateX(0) translateY(-6px);
  }
  .nav-item:last-child:hover .panel,
  .nav-item:last-child:focus-within .panel {
    transform: translateX(0) translateY(0);
  }
  .panel-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
  }
  .panel-list a {
    display: block; padding: var(--s-2) var(--s-3);
    font-size: var(--fs-sm); color: var(--text-muted);
    text-decoration: none; border-radius: var(--r-sm);
  }
  .panel-list a:hover { background: var(--brand-soft); color: var(--brand); }

  .header-actions { display: flex; gap: var(--s-2); align-items: center; }
  .icon-btn {
    display: inline-grid; place-items: center;
    width: 2.3rem; height: 2.3rem; padding: 0;
    background: transparent; color: var(--text-muted);
    border: 1px solid var(--border); border-radius: var(--r-md); cursor: pointer;
  }
  .icon-btn:hover { color: var(--brand); border-color: var(--brand-border); background: var(--surface-2); }
  .nav-toggle { display: none; }

  .mobile-nav { border-top: 1px solid var(--border); background: var(--surface);
    padding-block: var(--s-4); max-height: 74vh; overflow-y: auto; }
  .m-group { border: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: none; margin: 0; }
  .m-group summary { padding: var(--s-4) 0; }
  .m-group ul { list-style: none; margin: 0; padding: 0 0 var(--s-3); }
  .m-group ul a { display: block; padding: var(--s-3) var(--s-3);
    color: var(--text-muted); text-decoration: none; font-size: var(--fs-sm); border-radius: var(--r-sm); }
  .m-group ul a:hover { background: var(--surface-2); color: var(--brand); }
  .m-group > :not(summary) { padding-inline: 0; }

  @media (max-width: 60rem) {
    .nav { display: none; }
    .nav-toggle { display: inline-grid; }
    .header-inner { justify-content: space-between; }
  }
</style>

<script>
  // Theme toggle. Reads may throw in privacy modes, so every access is guarded
  // and the page must render correctly with no stored value.
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const stored = (() => { try { return localStorage.getItem('ge-theme'); } catch { return null; } })();
  if (stored === 'light' || stored === 'dark') root.setAttribute('data-theme', stored);

  btn?.addEventListener('click', () => {
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = root.getAttribute('data-theme') ?? (prefersDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('ge-theme', next); } catch { /* non-fatal */ }
  });

  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (mobile) (mobile as HTMLElement).hidden = open;
  });
</script>
