---
/**
 * Article sidebar.
 *
 * Shape borrowed from what works on the reference sites — a sticky rail of stacked
 * cards beside the prose — but the contents are deliberately not theirs. Going Low's
 * rail is promo banners and a recent-posts feed pointing at two hub pages. Ours
 * carries the things this site actually has and they do not: the free tool for this
 * cluster, the rest of the cluster, and a plain statement of how the page was made.
 *
 * Two slots are deliberately absent until they are real:
 *   - a newsletter block (there is no list yet)
 *   - an affiliate/product promo (there are no programs yet)
 * Adding either before it exists would mean shipping a dead form or a fake offer.
 */
import Toc from './Toc.astro';
import { CLUSTER_TOOL, clusterById, type ClusterId } from '../consts';
import { CHILDREN } from '../data/clusters';
import type { Heading } from '../lib/toc';

interface Props {
  cluster: ClusterId;
  headings: Heading[];
  /** Current path, so the article never links to itself in the sibling list. */
  path: string;
}
const { cluster, headings, path } = Astro.props;

const c = clusterById(cluster);
const tool = CLUSTER_TOOL[cluster];

// Siblings: built pages only, so the rail can never ship a 404 — same gate as NAV.
const siblings = (CHILDREN[cluster] ?? [])
  .filter((i) => i.ready && i.href !== path)
  .slice(0, 4);
---
<aside class="rail" aria-label="Article sidebar">
  <div class="rail-inner">
    <Toc headings={headings} variant="rail" />

    {tool && (
      <section class="card card-tool">
        <p class="card-kicker">Free tool · no signup</p>
        <h2 class="card-h"><a href={tool.href}>{tool.name}</a></h2>
        <p class="card-p">{tool.pitch}</p>
        <a class="card-cta" href={tool.href}>Open the tool &rarr;</a>
      </section>
    )}

    {siblings.length > 0 && (
      <section class="card">
        <p class="card-kicker">More in {c.label}</p>
        <ul class="card-list">
          {siblings.map((i) => (
            <li><a href={i.href}>{i.title}</a></li>
          ))}
        </ul>
        <a class="card-cta" href={c.href}>All of {c.label} &rarr;</a>
      </section>
    )}

    <section class="card card-trust">
      <p class="card-kicker">How we work</p>
      <ul class="trust">
        <li>Articles are written by the Going Eagle editorial team. A working golf coach reviews them, and each page states whether that review has happened yet.</li>
        <li>We say plainly whether something was tested hands-on, measured, or researched.</li>
        <li>Commission never moves a ranking. If the cheaper product is better, it goes first.</li>
      </ul>
      <p class="trust-links">
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/gear/how-we-test/">How we test</a>
        <a href="/affiliate-disclosure/">Disclosure</a>
      </p>
    </section>
  </div>
</aside>

<style>
  .rail { min-width: 0; }

  /* Sticky is applied only at the width where the rail actually sits beside the
     prose. Below that the rail is a normal stacked block after the article. */
  @media (min-width: 68rem) {
    .rail-inner {
      position: sticky;
      top: calc(var(--header-h) + var(--s-4));
      display: grid;
      gap: var(--s-4);
    }
  }
  @media (max-width: 67.99rem) {
    .rail-inner { display: grid; gap: var(--s-4); }
  }

  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: var(--s-4) var(--s-5);
  }
  .card-kicker {
    margin: 0 0 var(--s-3); font-size: var(--fs-xs); font-weight: 700;
    letter-spacing: .09em; text-transform: uppercase; color: var(--text-subtle);
  }
  .card-h { font-size: var(--fs-md); line-height: 1.3; margin: 0 0 var(--s-2); }
  .card-h a { color: inherit; text-decoration: none; }
  .card-h a:hover { color: var(--brand); }
  .card-p { margin: 0 0 var(--s-3); font-size: var(--fs-sm); color: var(--text-muted);
    line-height: 1.6; }
  .card-cta { display: inline-block; font-size: var(--fs-sm); font-weight: 600;
    color: var(--brand); text-decoration: none; }
  .card-cta:hover { text-decoration: underline; }

  /* The tool is this site's actual differentiator, so it is the one block in the
     rail that gets brand weight. */
  .card-tool { background: var(--brand-soft); border-color: var(--brand-border); }
  .card-tool .card-kicker { color: var(--brand); }

  .card-list { list-style: none; margin: 0 0 var(--s-3); padding: 0; display: grid; }
  .card-list li + li { border-top: 1px solid var(--border); }
  .card-list a { display: block; padding: var(--s-2) 0; font-size: var(--fs-sm);
    line-height: 1.45; color: var(--text); text-decoration: none; }
  .card-list a:hover { color: var(--brand); }

  .card-trust { background: var(--surface-2); }
  .trust { list-style: none; margin: 0 0 var(--s-3); padding: 0; display: grid;
    gap: var(--s-2); }
  .trust li { font-size: var(--fs-xs); color: var(--text-muted); line-height: 1.6;
    padding-left: var(--s-4); position: relative; }
  .trust li::before { content: ''; position: absolute; left: 0; top: .5em;
    width: .4rem; height: .4rem; border-radius: 50%; background: var(--brand); }
  .trust-links { margin: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .trust-links a { font-size: var(--fs-xs); font-weight: 600; color: var(--brand);
    text-decoration: none; }
  .trust-links a:hover { text-decoration: underline; }
</style>
