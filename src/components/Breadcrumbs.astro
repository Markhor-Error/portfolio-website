---
interface Props { trail: { name: string; href: string }[] }
const { trail } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {trail.map((c, i) => (
      <li>
        {i < trail.length - 1
          ? <a href={c.href}>{c.name}</a>
          : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2);
    list-style: none; margin: 0 0 var(--s-4); padding: 0;
    font-size: var(--fs-xs); color: var(--text-subtle);
  }
  .crumbs li { display: flex; align-items: center; gap: var(--s-2); }
  .crumbs li + li::before { content: '/'; color: var(--border-strong); }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--brand); text-decoration: underline; }
  .crumbs [aria-current] { color: var(--text); font-weight: 600; }
</style>
