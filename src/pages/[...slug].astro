---
import { getCollection, render } from 'astro:content';
import Article from '../layouts/Article.astro';
import { clusterById } from '../consts';

export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

// Related links are authored as paths; resolve titles from the collection where
// the target exists so the cards never show a raw URL.
const all = await getCollection('articles');
const related = d.related.map((href: string) => {
  const match = all.find((a) => `/${a.id}/` === href);
  return match
    ? { title: match.data.title, href, blurb: match.data.intent }
    : { title: href.replace(/\//g, ' ').trim().replace(/-/g, ' '), href };
});
---
<Article
  title={d.title}
  description={d.description}
  cluster={d.cluster}
  published={d.published}
  updated={d.updated}
  reviewed={d.reviewed}
  headings={headings}
  faqs={d.faqs}
  related={related}
>
  <Content />
</Article>
